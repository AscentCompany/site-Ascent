# =============================================================
# ascent-api — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# Nunca commite o .env com dados reais.
# =============================================================

# -------------------------------------------------------------
# Servidor de aplicação
# -------------------------------------------------------------
APP_HOST=localhost
APP_PORT=3333
AMBIENTE_PROCESSO=desenvolvimento

# -------------------------------------------------------------
# Banco de dados MySQL
# Atenção: se a senha contiver caracteres especiais, envolva-a
# entre aspas simples no .env (ex: DB_PASSWORD='s&nha#123')
# -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ascent
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
