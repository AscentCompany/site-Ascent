# =============================================================
# ascent-apachepoi — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# Nunca commite o .env com dados reais.
# =============================================================

# -------------------------------------------------------------
# Banco de dados MySQL
# -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ascent
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# -------------------------------------------------------------
# AWS S3 — fonte de dados da planilha ANAC
# -------------------------------------------------------------
AWS_ACCESS_KEY_ID=sua_access_key
AWS_SECRET_ACCESS_KEY=sua_secret_key
AWS_BUCKET=ascent-database-318401088884-us-east-1-an
AWS_ARQUIVO_ANAC=anac_brazil.xlsx

# -------------------------------------------------------------
# Importação automática ao subir o serviço (true / false)
# -------------------------------------------------------------
AUTO_IMPORT=false
