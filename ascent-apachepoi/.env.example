# =============================================================
# ascent-apachepoi — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# Nunca commite o .env com dados reais.
# =============================================================

# -------------------------------------------------------------
# Banco de dados MySQL
# -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ascent
DB_USER=admin
DB_PASSWORD=admin

# -------------------------------------------------------------
# AWS S3 — Vocareum / AWS Academy Learner Lab (voclabs)
# Região: Virgínia do Norte (us-east-1)
# -------------------------------------------------------------
AWS_REGION=us-east-1
AWS_BUCKET=ascent-base-de-dados
AWS_PREFIXO_ARQUIVOS=anac_part_
AWS_TOTAL_PARTES=23
AWS_ARQUIVO_ANAC=anac_part_001.xlsx

# Credenciais temporárias do Vocareum (obtidas em "AWS Details" -> "AWS CLI"):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# -------------------------------------------------------------
# Importação automática ao subir o serviço (true / false)
# -------------------------------------------------------------
AUTO_IMPORT=true
