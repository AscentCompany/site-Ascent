# =============================================================
# .gitignore — Ascent
# =============================================================

# IDEs e Editores
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db

# Java / Maven
target/
**/target/
*.class
*.jar
*.war
*.nar
*.ear

# Node.js
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variáveis de Ambiente e Credenciais (NUNCA commitar)
.env
**/.env
*.env.local
*.env.*.local
!*.env.example

# Logs de Execução e Runtime
# Shell scripts locais (não versionados)
*.sh
# Exceção: start.sh é versionado — necessário para deploy na nuvem
!start.sh
!setup-duckdns.sh
!run-importacao-s3.sh
!start-logs.sh
!importar-anac.sh

# Logs gerados em runtime
*.log
*.log.*
start.log
importacao.log
dados/logs/
logs/
dados/logs/

# Locks de execução
*.lock

# Marcador da importação única do apache-poi
.apachepoi-executado

# Locks de Execução e Marcadores
*.lock
.*.lock
.apachepoi-executado

# Dados persistidos e Diretórios Locais
/dados/
dados/

# Shell scripts locais (apenas os 3 scripts oficiais são versionados)
*.sh
!start.sh
!setup-duckdns.sh
!apache-po.sh
