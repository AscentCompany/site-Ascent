# =============================================================
# .env.example — Ascent (docker-compose)
#
# Copie este arquivo para .env e preencha os valores reais.
#   cp .env.example .env
#
# NUNCA commite o .env com dados reais no repositório.
# =============================================================

# -------------------------------------------------------------
# MySQL — usado pelo container "mysql" e por todos os serviços
# -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=troque_pela_senha_root
DB_DATABASE=ascent
DB_USER=ascent_user
DB_PASSWORD=troque_pela_senha_do_usuario

# -------------------------------------------------------------
# ascent-api — servidor Node.js / Express
# -------------------------------------------------------------
APP_PORT=3333
# APP_HOST não precisa ser alterado no docker-compose;
# o serviço sempre escuta em 0.0.0.0 dentro do container.

# -------------------------------------------------------------
# ascent-logs — notificador (Slack + e-mail)
# -------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/SEU/WEBHOOK/GERAL
SLACK_WEBHOOK_CADASTRO_URL=https://hooks.slack.com/services/SEU/WEBHOOK/CADASTRO
EMAIL_REMETENTE=seuemail@gmail.com
SENHA_APP=sua_senha_de_app_gmail

# -------------------------------------------------------------
# ascent-apachepoi — leitor de planilha ANAC via AWS S3
# Crie um usuário IAM com permissão s3:GetObject no bucket.
# -------------------------------------------------------------
AWS_ACCESS_KEY_ID=sua_access_key_id
AWS_SECRET_ACCESS_KEY=sua_secret_access_key
AWS_BUCKET=ascent-database-318401088884-us-east-1-an
AWS_ARQUIVO_ANAC=anac_brazil.xlsx
# AUTO_IMPORT=true faz o serviço rodar em loop; false roda uma vez e para
AUTO_IMPORT=false
