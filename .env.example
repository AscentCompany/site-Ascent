# =============================================================
# .env.example — Ascent
#
# Copie este arquivo para .env e preencha os valores reais.
#   cp .env.example .env
#
# NUNCA commite o .env com dados reais no repositório.
#
# docker-compose sobe apenas mysql + ascent-api.
# Os serviços Java (ascent-logs, ascent-apachepoi) sobem via start.sh.
# =============================================================

# -------------------------------------------------------------
# MySQL — usado pelo container "mysql" e por todos os serviços
# -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
# Dentro da rede Docker o MySQL atende pelo nome do serviço: "mysql".
# Rodando Java/Node FORA do Docker na EC2, use "localhost"
# (a porta 3306 é publicada apenas no loopback da máquina).
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ascent
DB_USER=admin
DB_PASSWORD=admin

# -------------------------------------------------------------
# ascent-api — servidor Node.js / Express
# -------------------------------------------------------------
APP_PORT=3333
# Endereço do serviço Java de notificações.
# No docker-compose o valor correto é http://ascent-logs:8080.
NOTIFICADOR_URL=http://ascent-logs:8080

# -------------------------------------------------------------
# ascent-logs — notificador Java (Slack + e-mail) — via start.sh
# -------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/SEU/WEBHOOK/GERAL
SLACK_WEBHOOK_CADASTRO_URL=https://hooks.slack.com/services/SEU/WEBHOOK/CADASTRO
EMAIL_REMETENTE=seuemail@gmail.com
SENHA_APP=sua_senha_de_app_gmail

# -------------------------------------------------------------
# ascent-apachepoi — Java leitor ANAC via S3 — via start.sh
# Na EC2 com LabRole, as chaves podem ficar vazias.
# -------------------------------------------------------------
AWS_REGION=us-east-1
AWS_BUCKET=ascent-base-de-dados
AWS_PREFIXO_ARQUIVOS=anac_part_
AWS_TOTAL_PARTES=23
AWS_ARQUIVO_ANAC=anac_part_001.xlsx
# AUTO_IMPORT=true faz o serviço rodar em loop; false roda uma vez e para
AUTO_IMPORT=true

# Credenciais AWS (preencha se não estiver na EC2 com IAM Role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
