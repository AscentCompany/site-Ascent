# .env.example - variables used by both ascent-logs and ascent-apachepoi services
# MySQL connection (Docker container)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ascent
DB_USER=admin
DB_PASSWORD=admin

# AWS S3 configuration for Apache POI data source
AWS_BUCKET=ascent-database-318401088884-us-east-1-an
AWS_ARQUIVO_ANAC=anac_brazil.xlsx

# Optional: enable automatic import on service start (true/false)
AUTO_IMPORT=false
