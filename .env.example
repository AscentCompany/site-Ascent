# =============================================================
# .env.example — Ascent
#
# Copie este arquivo para .env e preencha os valores reais.
#   cp .env.example .env
#
# NUNCA commite o .env com dados reais no repositório.
#
# Scripts:
#   ./start.sh          → pull + MySQL + API + logs + DuckDNS
#   ./inserir-dados.sh  → schema + usuários/companhia (seed)
#   ./importar-anac.sh  → Apache POI lê S3 e grava voos
# =============================================================

# -------------------------------------------------------------
# MySQL — usado pelo container "mysql" e por todos os serviços
# -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
# Dentro da rede Docker o host CORRETO é o nome do serviço: "mysql".
# NÃO use ascent-mysql (nome do container) — quebra a resolução DNS.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ascent
DB_USER=admin
DB_PASSWORD=admin

# -------------------------------------------------------------
# ascent-api — servidor Node.js / Express
# -------------------------------------------------------------
APP_PORT=3333
NOTIFICADOR_URL=http://ascent-logs:8080

# -------------------------------------------------------------
# ascent-logs — notificador Java (Slack + e-mail)
# -------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/SEU/WEBHOOK/GERAL
SLACK_WEBHOOK_CADASTRO_URL=https://hooks.slack.com/services/SEU/WEBHOOK/CADASTRO
EMAIL_REMETENTE=seuemail@gmail.com
SENHA_APP=sua_senha_de_app_gmail

# -------------------------------------------------------------
# ascent-apachepoi — Java leitor ANAC via S3 (./importar-anac.sh)
# Na EC2 com LabRole, deixe as chaves VAZIAS.
# Session tokens de lab EXPIREM — 400 Bad Request no S3.
# -------------------------------------------------------------
AWS_REGION=us-east-1
AWS_BUCKET=ascent-base-de-dados
AWS_PREFIXO_ARQUIVOS=anac_part_
AWS_TOTAL_PARTES=23
AWS_ARQUIVO_ANAC=anac_part_001.xlsx
AUTO_IMPORT=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
