# =============================================================
# site-Ascent — guia de variáveis de ambiente por módulo
# Cada módulo tem seu próprio .env.example na sua pasta.
# Este arquivo serve como referência consolidada do projeto.
# =============================================================

# -------------------------------------------------------------
# ascent-api  →  ascent-api/.env.example
# -------------------------------------------------------------
APP_HOST=localhost
APP_PORT=3333
AMBIENTE_PROCESSO=desenvolvimento
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ascent
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# -------------------------------------------------------------
# ascent-logs  →  ascent-logs/.env.example
# -------------------------------------------------------------
# DB_HOST, DB_PORT, DB_DATABASE, DB_USER, DB_PASSWORD (idem acima)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/SEU/WEBHOOK/GERAL
SLACK_WEBHOOK_CADASTRO_URL=https://hooks.slack.com/services/SEU/WEBHOOK/CADASTRO
EMAIL_REMETENTE=seuemail@gmail.com
SENHA_APP=sua_senha_de_app_gmail

# -------------------------------------------------------------
# ascent-apachepoi  →  ascent-apachepoi/.env.example
# Leitura de planilha ANAC via S3 + inserção no banco.
# -------------------------------------------------------------
# DB_HOST, DB_PORT, DB_DATABASE, DB_USER, DB_PASSWORD (idem acima)
AWS_ACCESS_KEY_ID=sua_access_key
AWS_SECRET_ACCESS_KEY=sua_secret_key
AWS_BUCKET=ascent-database-318401088884-us-east-1-an
AWS_ARQUIVO_ANAC=anac_brazil.xlsx
AUTO_IMPORT=false
